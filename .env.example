# Copy to .env (local) or paste into Portainer's stack "Environment variables".
# Generate secrets with:  openssl rand -hex 32
# (Use hex, not base64: PUBLIC_DB_PASSWORD goes into a connection URL, where '/' or '+' break it.)

DB_OWNER_PASSWORD=change-me
PUBLIC_DB_PASSWORD=change-me-too
ADMIN_DB_PASSWORD=change-me-three
# Used to derive opaque public photo IDs. Keep it stable: changing it changes every URL.
PUBLIC_ID_SECRET=change-me-to-at-least-32-random-characters

# --- Tunnel: choose ONE mode ---------------------------------------------
# Bundled tunnel: this profile is required to start the bundled cloudflared.
# Remove this line when using docker-compose.shared-tunnel.yml.
COMPOSE_PROFILES=bundled-tunnel
# Only needed with the bundled tunnel.
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
TUNNEL_TOKEN=
# Only used with the shared-tunnel override (docker-compose.shared-tunnel.yml):
# the external Docker network your existing cloudflared container is on.
TUNNEL_NETWORK=proxy

# Immich, reached over Docker networking (never over the internet).
IMMICH_URL=http://immich_server:2283
# Name of the Docker network your Immich stack uses (docker network ls).
IMMICH_NETWORK=immich_default

# Shared-link keys to publish (the part after /share/ in the Immich link), comma-separated.
# In Immich, enable "Show metadata" on the link, and leave it without a password.
SHARED_LINK_KEYS=

# Host folder for the database and image cache (bind mounts, easy to back up).
# Created automatically on first deploy.
DATA_DIR=/srv/docker/immich-showcase

# Database backups (verified pg_dump files). Best on a different drive from DATA_DIR,
# e.g. /mnt/hdd1-main/files/backups/immich-showcase (also picked up by Syncthing).
# Default: $DATA_DIR/backups
BACKUP_DIR=/srv/docker/immich-showcase/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# --- Admin app (gallery-admin hostname, behind Cloudflare Access) -------
# Zero Trust → Settings → Custom Pages shows your team domain: <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust → Access → Applications → your admin app → Overview → Application Audience (AUD) Tag
CF_ACCESS_AUD=
# Who may use the admin app (also enforce this in the Access policy). Comma-separated.
ADMIN_EMAILS=
# Public gallery URL, for the "View site" link in the admin app.
PUBLIC_SITE_URL=

SITE_TITLE=Photos

# Videos are re-encoded to 720p (metadata stripped) in the background.
# ffmpeg threads per encode (keep low so the server stays responsive).
VIDEO_THREADS=2
# The admin app shows a warning on videos larger than this (MB, as received from Immich).
VIDEO_WARN_MB=500
SYNC_INTERVAL_MINUTES=15
