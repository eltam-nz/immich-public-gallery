# Copy to .env (local) or paste into Portainer's stack "Environment variables".
# Generate secrets with:  openssl rand -base64 36

DB_OWNER_PASSWORD=change-me
PUBLIC_DB_PASSWORD=change-me-too
# Used to derive opaque public photo IDs. Keep it stable: changing it changes every URL.
PUBLIC_ID_SECRET=change-me-to-at-least-32-random-characters

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
TUNNEL_TOKEN=

# Immich, reached over Docker networking (never over the internet).
IMMICH_URL=http://immich_server:2283
# Name of the Docker network your Immich stack uses (docker network ls).
IMMICH_NETWORK=immich_default

# Shared-link keys to publish (the part after /share/ in the Immich link), comma-separated.
# In Immich, enable "Show metadata" on the link, and leave it without a password.
SHARED_LINK_KEYS=

SITE_TITLE=Photos
SYNC_INTERVAL_MINUTES=15
# -1 hides coordinates; 0-4 keeps that many decimals (1 ≈ 11 km, 2 ≈ 1.1 km).
DEFAULT_GPS_PRECISION=-1
