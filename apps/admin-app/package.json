{
  "name": "@showcase/admin-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./web/tsconfig.json",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@showcase/shared": "workspace:*",
    "fastify": "^5.12.0",
    "jose": "^6.0.11",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.16.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
